      "excerpt": "def retry_call(operation, attempts=3, delay=0.1):\n    for attempt in range(attempts):\n        try:\n            return operation()\n        except TimeoutError:\n            if attempt + 1 == attempts:\n                raise\n            time.sleep(delay)",
